        },
        {
          "name": "Analytics for premium owner",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{premium_token}}"}],
            "url": "{{base_url}}/api/ads/{{ad_id}}/analytics"
