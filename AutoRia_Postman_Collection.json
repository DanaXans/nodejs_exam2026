{
  "info": {
    "_postman_id": "a9b1c2d3-e4f5-4a6b-8c7d-0e1f2a3b4c5d",
    "name": "AutoRia Exam 2026",
    "description": "Перевірка ТЗ. Перед запуском підніміть API і MongoDB. Адмін створюється сам: admin@autoria.local / admin123. Для стабільних курсів поставте USE_MOCK_RATES=true.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:5000/api"},
    {"key": "token", "value": ""},
    {"key": "adId", "value": ""},
    {"key": "badAdId", "value": ""},
    {"key": "adminToken", "value": ""},
    {"key": "managerToken", "value": ""},
    {"key": "badUserId", "value": ""}
  ],
  "item": [
    {
      "name": "01. Register Seller",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "const data = pm.response.json();",
        "pm.test('201', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('token', data.token);",
        "pm.test('seller basic', () => {",
        "  pm.expect(data.user.role).to.eql('SELLER');",
        "  pm.expect(data.user.accountType).to.eql('BASIC');",
        "});"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"name\": \"Dana Seller\",\n  \"email\": \"seller_exam@test.com\",\n  \"password\": \"Password123!\"\n}"},
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "02. Login Seller",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "const data = pm.response.json();",
        "pm.test('200', () => pm.response.to.have.status(200));",
        "pm.collectionVariables.set('token', data.token);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"email\": \"seller_exam@test.com\",\n  \"password\": \"Password123!\"\n}"},
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "03. Brands include BMW X5 and Daewoo Lanos",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "const data = pm.response.json();",
        "pm.test('catalog', () => {",
        "  pm.expect(data.BMW).to.include('X5');",
        "  pm.expect(data.Daewoo).to.include('Lanos');",
        "});"
      ]}}],
      "request": {"method": "GET", "url": "{{baseUrl}}/brands"}
    },
    {
      "name": "04. Create 1st ad (BASIC)",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "const data = pm.response.json();",
        "pm.test('201 active', () => {",
        "  pm.response.to.have.status(201);",
        "  pm.expect(data.status).to.eql('ACTIVE');",
        "  pm.expect(data.originalPrice).to.eql(45000);",
        "  pm.expect(data.originalCurrency).to.eql('USD');",
        "  pm.expect(data.exchangeRatesUsed.USD_UAH).to.be.a('number');",
        "  pm.expect(data.exchangeRatesUsed.EUR_UAH).to.be.a('number');",
        "  pm.expect(data.exchangeRatesUsed.date).to.be.a('string');",
        "});",
        "pm.collectionVariables.set('adId', data._id);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"title\": \"BMW X5 2021\",\n  \"description\": \"Офіційне авто, перший власник.\",\n  \"make\": \"BMW\",\n  \"model\": \"X5\",\n  \"region\": \"Київ\",\n  \"originalPrice\": 45000,\n  \"originalCurrency\": \"USD\"\n}"},
        "url": "{{baseUrl}}/ads"
      }
    },
    {
      "name": "05. Second ad on BASIC is forbidden",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "pm.test('403', () => pm.response.to.have.status(403));"
      ]}}],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{token}}"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"title\": \"Audi Q7\",\n  \"description\": \"Друге авто на базовому акаунті.\",\n  \"make\": \"Audi\",\n  \"model\": \"Q7\",\n  \"region\": \"Львівська область\",\n  \"originalPrice\": 40000,\n  \"originalCurrency\": \"EUR\"\n}"},
        "url": "{{baseUrl}}/ads"
      }
    },
