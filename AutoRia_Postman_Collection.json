          ]
        },
        "description": "Mock-апгрейд до PREMIUM. Оновлений токен автоматично записується у {{token}}."
      }
    },
    {
      "name": "06. Create 2nd Car Ad (PREMIUM - Success)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Audi Q7 2020 Quattro\",\n  \"description\": \"Друге авто успішно створюється після отримання статусу PREMIUM.\",\n  \"make\": \"Audi\",\n  \"model\": \"Q7\",\n  \"region\": \"Львівська область\",\n  \"originalPrice\": 40000,\n  \"originalCurrency\": \"USD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ads",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ads"
          ]
        },
        "description": "Створення другого оголошення без обмежень (PREMIUM)."
      }
    },
    {
      "name": "07. Get All Ads",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/ads",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ads"
          ]
        },
        "description": "Каталог оголошень з розрахунком валют (USD, EUR, UAH)."
      }
    },
    {
      "name": "08. Get Ad Analytics (PREMIUM Only)",
      "request": {
        "method": "GET",
        "header": [
          {
