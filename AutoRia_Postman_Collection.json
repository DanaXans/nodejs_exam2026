        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "09. Open ad as buyer counts a view",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "const data = pm.response.json();",
        "pm.test('contact and price', () => {",
        "  pm.expect(data.sellerEmail).to.be.a('string').and.not.empty;",
        "  pm.expect(data.originalPrice).to.eql(45000);",
        "  pm.expect(data.views).to.be.at.least(1);",
        "});"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{buyerToken}}"}],
        "url": "{{baseUrl}}/ads/{{adId}}"
      }
    },
    {
      "name": "10. Premium analytics",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "const data = pm.response.json();",
        "pm.test('stats', () => {",
        "  pm.response.to.have.status(200);",
        "  pm.expect(data.views).to.be.a('number');",
        "  pm.expect(data.viewsDay).to.be.a('number');",
        "  pm.expect(data.viewsWeek).to.be.a('number');",
        "  pm.expect(data.viewsMonth).to.be.a('number');",
        "  pm.expect(data.avgPriceRegion).to.be.a('number');",
        "  pm.expect(data.avgPriceUkraine).to.be.a('number');",
        "  pm.expect(data.regionName).to.eql('Київ');",
        "});"
      ]}}],
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
        "url": "{{baseUrl}}/ads/{{adId}}/analytics"
      }
    },
