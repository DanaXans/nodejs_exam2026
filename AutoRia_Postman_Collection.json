        "description": "Аналітика для PREMIUM: перегляди, середня ціна по регіону та Україні."
      }
    },
    {
      "name": "09. Delete Ad",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/ads/{{adId}}",
          "host": [
