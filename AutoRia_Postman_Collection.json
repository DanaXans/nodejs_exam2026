{
  "info": {
    "_postman_id": "a9b1c2d3-e4f5-4a6b-8c7d-0e1f2a3b4c5d",
    "name": "AutoRia Exam 2026 - Test Flow",
    "description": "Колекція запитів для перевірки виконання ТЗ AutoRia Clone.\nПослідовний flow: Реєстрація -> Логін -> Створення оголошення (Basic) -> Перевірка ліміту -> Upgrade до Premium -> Створення другого оголошення (Premium) -> Отримання списку -> Аналітика -> Видалення.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "adId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Register Seller",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201 || pm.response.code === 200) {",
              "    const data = pm.response.json();",
              "    if (data.token) {",
              "        pm.collectionVariables.set('token', data.token);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dana Seller\",\n  \"email\": \"seller_exam@test.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "Реєстрація нового користувача з роллю SELLER та типом BASIC за замовчуванням."
      }
    },
    {
      "name": "02. Login Seller",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const data = pm.response.json();",
              "    if (data.token) {",
              "        pm.collectionVariables.set('token', data.token);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"seller_exam@test.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Авторизація. Токен автоматично зберігається у змінну {{token}}."
      }
    },
    {
      "name": "03. Create 1st Car Ad (BASIC)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201 || pm.response.code === 200) {",
              "    const data = pm.response.json();",
              "    const createdAd = data.ad || data;",
              "    if (createdAd._id || createdAd.id) {",
              "        pm.collectionVariables.set('adId', createdAd._id || createdAd.id);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"BMW X5 2021 в ідеальному стані\",\n  \"description\": \"Офіційне авто, перший власник, повне сервісне обслуговування.\",\n  \"make\": \"BMW\",\n  \"model\": \"X5\",\n  \"region\": \"Київ\",\n  \"originalPrice\": 45000,\n  \"originalCurrency\": \"USD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ads",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ads"
          ]
        },
        "description": "Створення першого авто для BASIC акаунта. ID зберігається у {{adId}}."
      }
    },
    {
      "name": "04. Create 2nd Car Ad (BASIC - Expect 403 Limit Error)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Audi Q7 2020 Quattro\",\n  \"description\": \"Спроба викласти друге оголошення на базовому акаунті.\",\n  \"make\": \"Audi\",\n  \"model\": \"Q7\",\n  \"region\": \"Львівська область\",\n  \"originalPrice\": 40000,\n  \"originalCurrency\": \"USD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ads",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ads"
          ]
        },
        "description": "Перевірка обмеження: очікується 403 (BASIC: максимум 1 оголошення)."
      }
    },
    {
      "name": "05. Upgrade to Premium",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const data = pm.response.json();",
              "    if (data.token) {",
              "        pm.collectionVariables.set('token', data.token);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
