{
  "info": {
    "name": "AutoRia clone",
    "description": "Перевірка API платформи продажу авто. Спочатку виконайте запити логіну: скрипти збережуть токени в змінні колекції.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:5000"},
    {"key": "admin_token", "value": ""},
    {"key": "premium_token", "value": ""},
    {"key": "basic_token", "value": ""},
    {"key": "buyer_token", "value": ""},
    {"key": "manager_token", "value": ""},
    {"key": "new_seller_token", "value": ""},
    {"key": "ad_id", "value": ""},
    {"key": "basic_ad_id", "value": ""},
    {"key": "pending_ad_id", "value": ""},
    {"key": "catalog_request_id", "value": ""},
    {"key": "buyer_id", "value": ""},
    {"key": "new_seller_id", "value": ""},
    {"key": "dealership_id", "value": ""}
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login admin",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const data = pm.response.json();", "pm.collectionVariables.set('admin_token', data.token);"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"admin@autoria.local\",\n  \"password\": \"Admin123!\"\n}"},
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Login premium seller",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const data = pm.response.json();", "pm.collectionVariables.set('premium_token', data.token);"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"seller.premium@autoria.local\",\n  \"password\": \"Seller123!\"\n}"},
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Login basic seller",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const data = pm.response.json();", "pm.collectionVariables.set('basic_token', data.token);"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"seller.basic@autoria.local\",\n  \"password\": \"Seller123!\"\n}"},
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Login buyer",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const data = pm.response.json();", "if (data.token) pm.collectionVariables.set('buyer_token', data.token);", "if (data.user) pm.collectionVariables.set('buyer_id', data.user.id);"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"buyer@autoria.local\",\n  \"password\": \"Buyer123!\"\n}"},
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Register seller",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const data = pm.response.json();", "if (data.token) pm.collectionVariables.set('new_seller_token', data.token);", "if (data.user) pm.collectionVariables.set('new_seller_id', data.user.id);"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Олена\",\n  \"email\": \"olena@autoria.local\",\n  \"password\": \"123456\",\n  \"role\": \"SELLER\"\n}"},
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Register buyer",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Ігор\",\n  \"email\": \"igor@autoria.local\",\n  \"password\": \"123456\",\n  \"role\": \"BUYER\"\n}"},
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Register manager is forbidden",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Самозванець\",\n  \"email\": \"fake.manager@autoria.local\",\n  \"password\": \"123456\",\n  \"role\": \"MANAGER\"\n}"},
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{premium_token}}"}],
            "url": "{{base_url}}/api/auth/me"
          }
        },
        {
          "name": "Upgrade to premium (mock payment)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const data = pm.response.json();", "if (data.token) pm.collectionVariables.set('new_seller_token', data.token);"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{new_seller_token}}"}],
            "url": "{{base_url}}/api/auth/upgrade-to-premium"
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Makes",
          "request": {"method": "GET", "header": [], "url": "{{base_url}}/api/catalog/makes"}
        },
        {
          "name": "BMW models",
          "request": {"method": "GET", "header": [], "url": "{{base_url}}/api/catalog/makes/BMW/models"}
        },
        {
          "name": "Regions",
          "request": {"method": "GET", "header": [], "url": "{{base_url}}/api/catalog/regions"}
        },
        {
          "name": "PrivatBank rate for today",
          "request": {"method": "GET", "header": [], "url": "{{base_url}}/api/catalog/rates"}
        },
        {
          "name": "Request missing make",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const data = pm.response.json();", "if (data.request) pm.collectionVariables.set('catalog_request_id', data.request._id);"]}}],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{premium_token}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"type\": \"MAKE\",\n  \"name\": \"Tesla\"\n}"},
            "url": "{{base_url}}/api/catalog/requests"
          }
        },
        {
          "name": "List catalog requests",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{admin_token}}"}],
            "url": "{{base_url}}/api/catalog/requests?status=PENDING"
          }
        },
        {
          "name": "Approve catalog request",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"action\": \"APPROVE\"\n}"},
            "url": "{{base_url}}/api/catalog/requests/{{catalog_request_id}}"
          }
        },
        {
          "name": "Request missing model",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const data = pm.response.json();", "if (data.request) pm.collectionVariables.set('catalog_request_id', data.request._id);"]}}],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{premium_token}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"type\": \"MODEL\",\n  \"make\": \"Tesla\",\n  \"name\": \"Model 3\"\n}"},
            "url": "{{base_url}}/api/catalog/requests"
          }
        }
      ]
    },
    {
      "name": "Ads",
      "item": [
        {
          "name": "List active ads",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const data = pm.response.json();", "const ad = data.find((item) => item.make === 'BMW' && item.model === 'X5');", "if (ad) pm.collectionVariables.set('ad_id', ad._id);"]}}],
          "request": {"method": "GET", "header": [], "url": "{{base_url}}/api/ads"}
        },
        {
          "name": "Get one ad (counts a view)",
          "request": {"method": "GET", "header": [], "url": "{{base_url}}/api/ads/{{ad_id}}"}
        },
